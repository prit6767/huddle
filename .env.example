# Copy to .env and fill in what you need:  cp .env.example .env
# Nothing here is required to start — the planner runs with no key at all.

# ---- Claude ----
# Enables the general assistant (Q&A + web search) and better plan write-ups.
# Without it, planning still works via a deterministic keyword extractor.
ANTHROPIC_API_KEY=sk-ant-...

# ---- web app ----
# PORT=3000
# HUDDLE_PUBLIC_URL=https://huddle-hq.com   # used in share links posted to chats

# ---- group-chat bots (npm run bots) ----
# Telegram: @BotFather -> /newbot, then /setprivacy -> Disable (required)
# TELEGRAM_BOT_TOKEN=123456:ABC...

# Discord: developer portal -> Bot -> enable MESSAGE CONTENT INTENT (required)
# DISCORD_BOT_TOKEN=...

# Slack (Socket Mode — no public URL needed). Both tokens are required.
#   api.slack.com/apps -> Socket Mode -> app-level token (connections:write)
#   OAuth & Permissions -> Bot User OAuth Token
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# iMessage relay (macOS only; needs Full Disk Access on your terminal)
# ENABLE_IMESSAGE=1

# HUDDLE_WAKE_WORD=huddle          # say "huddle, ..." instead of @mentioning

# ---- one-tap add (optional) ----
# One bot instance serves unlimited groups, so once yours is running you can
# publish add-to-group links and nobody else needs to install anything. Set
# these and the landing page shows real buttons instead of setup steps.
# Leave them unset and it shows the setup steps, which is the honest default.
#
# Telegram: ?startgroup=true opens the "add to group" picker directly.
# HUDDLE_TELEGRAM_INVITE=https://t.me/YourBotName?startgroup=true
#
# Discord: the OAuth2 URL Generator link (scope=bot, plus Send Messages,
# Read Message History, Add Reactions).
# HUDDLE_DISCORD_INVITE=https://discord.com/oauth2/authorize?client_id=...&scope=bot&permissions=76800
#
# NOTE: whoever hosts pays for every group's usage. The per-chat and global
# daily caps in "cost control" below are what keep that bounded.

# ---- cost control ----
# HUDDLE_MODEL=claude-haiku-4-5    # default. claude-opus-5 = better answers, ~5x price
# HUDDLE_ASK_EFFORT=medium         # low | medium | high (ignored on Haiku-tier models)
# HUDDLE_MAX_SEARCHES=3            # web searches per question (billed separately)
# HUDDLE_CONTEXT_MESSAGES=20       # resent as input tokens on every question
# HUDDLE_DAILY_QUESTIONS_PER_CHAT=50
# HUDDLE_DAILY_QUESTIONS_TOTAL=500
# HUDDLE_CACHE_TTL_MS=600000       # repeat-question cache window

# ---- testing ----
# HUDDLE_DISABLE_LLM=1             # force the heuristic path even with a key set
