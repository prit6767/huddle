# Copy to .env and fill in what you need:  cp .env.example .env
# Nothing here is required to start — the planner runs with no key at all.

# ---- Claude ----
# Enables the general assistant (Q&A + web search) and better plan write-ups.
# Without it, planning still works via a deterministic keyword extractor.
ANTHROPIC_API_KEY=sk-ant-...

# ---- web app ----
# PORT=3000
# HUDDLE_PUBLIC_URL=https://huddle.example.com   # used in share links posted to chats

# ---- group-chat bots (npm run bots) ----
# Telegram: @BotFather -> /newbot, then /setprivacy -> Disable (required)
# TELEGRAM_BOT_TOKEN=123456:ABC...

# Discord: developer portal -> Bot -> enable MESSAGE CONTENT INTENT (required)
# DISCORD_BOT_TOKEN=...

# iMessage relay (macOS only; needs Full Disk Access on your terminal)
# ENABLE_IMESSAGE=1

# HUDDLE_WAKE_WORD=huddle          # say "huddle, ..." instead of @mentioning

# ---- cost control ----
# HUDDLE_MODEL=claude-haiku-4-5    # default. claude-opus-5 = better answers, ~5x price
# HUDDLE_ASK_EFFORT=medium         # low | medium | high (ignored on Haiku-tier models)
# HUDDLE_MAX_SEARCHES=3            # web searches per question (billed separately)
# HUDDLE_CONTEXT_MESSAGES=20       # resent as input tokens on every question
# HUDDLE_DAILY_QUESTIONS_PER_CHAT=50
# HUDDLE_DAILY_QUESTIONS_TOTAL=500
# HUDDLE_CACHE_TTL_MS=600000       # repeat-question cache window

# ---- testing ----
# HUDDLE_DISABLE_LLM=1             # force the heuristic path even with a key set
